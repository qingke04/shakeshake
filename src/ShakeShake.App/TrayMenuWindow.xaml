<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ShakeShake.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ShakeShake">

    <Border x:Name="MenuRoot"
            Background="{ThemeResource MenuFlyoutPresenterBackground}"
            BorderBrush="{ThemeResource MenuFlyoutPresenterBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="4"
            Translation="0,0,32">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        <StackPanel x:Name="ItemsHost" />
    </Border>
</Window>
