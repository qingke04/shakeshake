<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ShakeShake.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ShakeShake">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0">
            <StackPanel x:Name="PagePanel" MaxWidth="760" Padding="24,18,24,24" Spacing="8"
                        HorizontalAlignment="Stretch">

                <TextBlock x:Name="HeaderText" FontSize="28" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,2" />
                <TextBlock x:Name="HeaderSubText" Style="{StaticResource DescriptionStyle}"
                           Margin="0,0,0,10" />

                <!-- language -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LangLabel" Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="LangBox" Grid.Column="1" MinWidth="220"
                                  VerticalAlignment="Center"
                                  SelectionChanged="OnLanguageSelectionChanged" />
                    </Grid>
                </Border>

                <!-- enable -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="EnableTitle" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="EnableHint" Style="{StaticResource DescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="EnableToggle" Grid.Column="1" OnContent="" OffContent=""
                                      VerticalAlignment="Center" Toggled="OnEnableToggled" />
                    </Grid>
                </Border>

                <!-- magnification -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ZoomTitle" Style="{StaticResource SectionTitleStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ZoomValue" Grid.Column="1" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Slider x:Name="ZoomSlider" Minimum="20" Maximum="60" StepFrequency="1"
                                TickFrequency="5" ValueChanged="OnZoomChanged" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Canvas x:Name="PreviewCanvas" Width="152" Height="52" VerticalAlignment="Center">
                                <Path x:Name="PreviewSmall"
                                      Data="M 0.10,0.02 L 0.10,0.80 L 0.30,0.60 L 0.44,0.98 L 0.58,0.90 L 0.44,0.54 L 0.68,0.52 Z"
                                      Fill="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                      Stroke="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                      StrokeThickness="0.04"
                                      StrokeLineJoin="Round" />
                                <Path x:Name="PreviewBig"
                                      Data="M 0.10,0.02 L 0.10,0.80 L 0.30,0.60 L 0.44,0.98 L 0.58,0.90 L 0.44,0.54 L 0.68,0.52 Z"
                                      Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                      Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                      StrokeThickness="0.04"
                                      StrokeLineJoin="Round" />
                            </Canvas>
                            <TextBlock x:Name="ZoomHint" Grid.Column="1" Style="{StaticResource DescriptionStyle}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- exclude list -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="ExcludeTitle" Style="{StaticResource SectionTitleStyle}" />
                        <ListView x:Name="ExcludeList" Height="132" SelectionMode="Single"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                  CornerRadius="4" SelectionChanged="OnExcludeSelectionChanged" />
                        <TextBlock x:Name="ExcludeHint" Style="{StaticResource DescriptionStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnBrowse" Click="OnBrowseClick" />
                            <Button x:Name="BtnAddCurrent" Click="OnAddCurrentClick" />
                            <Button x:Name="BtnRemove" Click="OnRemoveClick" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- autostart -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AutostartTitle" Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="AutostartToggle" Grid.Column="1" OnContent="" OffContent=""
                                      VerticalAlignment="Center" Toggled="OnAutostartToggled" />
                    </Grid>
                </Border>

                <!-- advanced -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <Expander x:Name="AdvancedExpander" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock x:Name="AdvancedHeader" Style="{StaticResource SectionTitleStyle}"
                                       Margin="4,0,0,0" />
                        </Expander.Header>
                        <StackPanel Spacing="12" Padding="16,4,16,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SensLabel" VerticalAlignment="Center" MinWidth="76" />
                                <Slider x:Name="SensSlider" Grid.Column="1" Minimum="1" Maximum="10"
                                        StepFrequency="1" ValueChanged="OnSensChanged" />
                                <TextBlock x:Name="SensValue" Grid.Column="2" VerticalAlignment="Center"
                                           MinWidth="36" TextAlignment="Right" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="RestoreLabel" VerticalAlignment="Center" MinWidth="76" />
                                <Slider x:Name="RestoreSlider" Grid.Column="1" Minimum="50" Maximum="500"
                                        StepFrequency="10" TickFrequency="50" ValueChanged="OnRestoreChanged" />
                                <TextBlock x:Name="RestoreValue" Grid.Column="2" VerticalAlignment="Center"
                                           MinWidth="72" TextAlignment="Right" />
                            </Grid>
                            <TextBlock x:Name="AdvancedNote" Style="{StaticResource DescriptionStyle}" />
                        </StackPanel>
                    </Expander>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- pinned footer -->
        <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid Padding="24,10,24,10">
                <TextBlock x:Name="AboutText" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="BtnDefaults" Click="OnDefaultsClick" />
                    <Button x:Name="BtnClose" Style="{StaticResource AccentButtonStyle}"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
